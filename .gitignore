# ============================================================
# TransOS - Repository Ignore Policy
# ============================================================
#
# Purpose:
#   Keep source code, tests, documentation, and reproducible
#   project assets in Git while excluding generated binaries,
#   machine-specific configuration, migration output, and
#   temporary development artifacts.
#
# Notes:
#   - Paths beginning with "/" are relative to the repo root.
#   - Ignoring a file does not delete it from disk.
#   - Files already tracked by Git remain tracked.
#   - Never commit real user profiles, secrets, or WAL backups.
#
# ============================================================


# ------------------------------------------------------------
# 1. Compiled binaries and build output
# ------------------------------------------------------------

# Default Go build output on Linux/macOS
/transos

# Windows executables and generic compiled outputs
*.exe
*.out

# Build and distribution directories
/bin/
/build/
/dist/

# Cross-compiled release-test binaries
/transos-linux-amd64
/transos-linux-arm64


# ------------------------------------------------------------
# 2. Machine-specific configuration and extracted profiles
# ------------------------------------------------------------

# Local TransOS configuration
/transos_config.json

# Extracted user environment and generated configuration
/migration_profile.json
/transos_env.conf

# Generated migration plan
/migration_plan.json


# ------------------------------------------------------------
# 3. Generated migration packages and output
# ------------------------------------------------------------

# May contain scripts, manifests, backups, and user data
/target_output/


# ------------------------------------------------------------
# 4. Transaction logs, backups, and runtime diagnostics
# ------------------------------------------------------------

# Write-ahead logs and associated recovery backups
*.wal
*.wal.bak

# Runtime and diagnostic logs
*.log


# ------------------------------------------------------------
# 5. Temporary tests and migration workspaces
# ------------------------------------------------------------

/test_output/
/.test/
/.tmp/
/tmp/
/migration_workspace/

# Historical local test-output snapshots
/linux-current.txt
/linux-plan-test-current.txt


# ------------------------------------------------------------
# 6. Go test, coverage, and profiling artifacts
# ------------------------------------------------------------

*.test
*.prof

/coverage.out
/coverage.html


# ------------------------------------------------------------
# 7. Local patch handoffs and one-time helpers
# ------------------------------------------------------------

# Historical patches are not part of the source repository
/*.patch
/*.diff

# Obsolete local patch-application helper
/apply-transos-stage4.ps1


# ------------------------------------------------------------
# 8. Local release-audit script (temporary)
# ------------------------------------------------------------

# Keep this local until release tooling is moved to scripts/
# and reviewed for inclusion in the repository.
/transos-stage6h-release-audit.ps1


# ------------------------------------------------------------
# 9. Editor and IDE metadata
# ------------------------------------------------------------

.vscode/
.idea/


# ------------------------------------------------------------
# 10. Operating system metadata
# ------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini


# ============================================================
# End of TransOS .gitignore
# ============================================================